{
  // Type-checks the showcase page (npm run typecheck runs it with vue-tsc)
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["showcase/**/*.ts", "showcase/**/*.vue"]
}
