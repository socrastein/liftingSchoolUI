{
  // Type-checks the plain JavaScript modules and their tests from their JSDoc (npm run typecheck). Nothing is emitted.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["js/**/*.js", "tests/**/*.js"]
}
