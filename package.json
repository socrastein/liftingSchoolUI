{
  "name": "lifting-school-ui",
  "version": "0.8.2",
  "description": "The Lifting School's shared look: design tokens, base styles, component classes, fonts, icons and helpers for every site and app of the business.",
  "type": "module",
  "bin": {
    "check-placeholder-copy": "js/checkPlaceholderCopy.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/socrastein/liftingSchoolUI.git"
  },
  "files": [
    "components",
    "css",
    "fonts",
    "icons",
    "js"
  ],
  "exports": {
    "./components/*": "./components/*",
    "./css/*": "./css/*",
    "./fonts/*": "./fonts/*",
    "./icons/*": "./icons/*",
    "./plateColors": {
      "types": "./js/plateColors.d.ts",
      "default": "./js/plateColors.js"
    },
    "./styleRules": {
      "types": "./js/styleRules.d.ts",
      "default": "./js/styleRules.js"
    },
    "./fixedHeader": {
      "types": "./js/fixedHeader.d.ts",
      "default": "./js/fixedHeader.js"
    },
    "./colorScheme": {
      "types": "./js/colorScheme.d.ts",
      "default": "./js/colorScheme.js"
    },
    "./placeholderCopy": {
      "types": "./js/placeholderCopy.d.ts",
      "default": "./js/placeholderCopy.js"
    },
    "./placeholderCopyCheck": {
      "types": "./js/placeholderCopyCheck.d.ts",
      "default": "./js/placeholderCopyCheck.js"
    },
    "./dateUtils": {
      "types": "./js/dateUtils.d.ts",
      "default": "./js/dateUtils.js"
    },
    "./formFocus": {
      "types": "./js/formFocus.d.ts",
      "default": "./js/formFocus.js"
    },
    "./dropdownOption": {
      "types": "./js/dropdownOption.d.ts",
      "default": "./js/dropdownOption.js"
    },
    "./optionSearch": {
      "types": "./js/optionSearch.d.ts",
      "default": "./js/optionSearch.js"
    },
    "./panelPlacement": {
      "types": "./js/panelPlacement.d.ts",
      "default": "./js/panelPlacement.js"
    },
    "./choiceAfterPress": {
      "types": "./js/choiceAfterPress.d.ts",
      "default": "./js/choiceAfterPress.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "a11y": "vite build && node scripts/a11y.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && vue-tsc -p tsconfig.vue.json",
    "types": "tsc -p tsconfig.types.json",
    "types:check": "npm run types && git diff --exit-code -- js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^14.4.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.0.0 || ^15.0.0",
    "vue": "^3.5.0"
  }
}
