{
  "name": "lifting-school-ui",
  "version": "0.3.0",
  "description": "The Lifting School's shared look: design tokens, base styles, component classes, fonts, icons and helpers for every site and app of the business.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/socrastein/liftingSchoolUI.git"
  },
  "files": [
    "css",
    "fonts",
    "icons",
    "js"
  ],
  "exports": {
    "./css/*": "./css/*",
    "./fonts/*": "./fonts/*",
    "./icons/*": "./icons/*",
    "./plateColors": {
      "types": "./js/plateColors.d.ts",
      "default": "./js/plateColors.js"
    },
    "./styleRules": {
      "types": "./js/styleRules.d.ts",
      "default": "./js/styleRules.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "a11y": "vite build && node scripts/a11y.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && vue-tsc -p tsconfig.showcase.json",
    "types": "tsc -p tsconfig.types.json",
    "types:check": "npm run types && git diff --exit-code -- js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
