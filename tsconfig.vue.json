{
  // Type-checks everything written in Vue and TypeScript: the shared components, their tests and the showcase page
  // (npm run typecheck runs it with vue-tsc)
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["components/**/*.vue", "tests/components/**/*.ts", "showcase/**/*.ts", "showcase/**/*.vue"]
}
